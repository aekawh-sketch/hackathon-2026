# Локальный сервер в Docker: сайт из /srv, API — сервис api в той же сети.
# По http://localhost камера и датчики в браузере работают (localhost — безопасный адрес).
:80 {
	encode zstd gzip

	# Ссылка ранее перенесённой карты остаётся совместимой; основной адрес — /m/demo.
	redir /m/hakaton-osen-2026-manezh-dgtu-bccf39 /m/demo?{query} 302
	@oldDemo path_regexp oldDemo ^/p/hakaton-osen-2026-manezh-dgtu-bccf39/(.*)$
	rewrite @oldDemo /p/demo/{re.oldDemo.1}

	@api path /api/* /p/* /files/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Страница всегда свежая: после пересборки браузер берёт новую версию.
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
