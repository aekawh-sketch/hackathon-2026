# Настройки локального сервера в Docker (docker-compose.yml). Скопировать в .env и поменять пароли.

# Порт сайта на этом компьютере: http://localhost:8000
PORT=8000

# Пароль базы внутри Docker.
POSTGRES_PASSWORD=spacemap

# Демо-организатор и опубликованная площадка demo. Пустой пароль — демо не создаётся. Не меньше 8 символов.
DEMO_EMAIL=demo@space-map.local
DEMO_PASSWORD=

# Почты существующих аккаунтов администраторов всего сервиса, через запятую.
# Сначала зарегистрируйте аккаунт, затем добавьте его почту сюда и примените настройки API.
# Пусто — администраторов нет. В регистрации роль выбрать нельзя.
# После изменения: docker-compose up -d api (restart не перечитывает .env).
ADMIN_EMAILS=
