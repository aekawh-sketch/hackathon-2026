# Порт API. Vite в разработке проксирует на него /api, /p и /files.
PORT=8080

# База PostgreSQL. Для тестов — отдельная база в TEST_DATABASE_URL.
DATABASE_URL=postgres://localhost/spacemap
TEST_DATABASE_URL=postgres://localhost/spacemap_test

# Каталог хранилища файлов (локальный драйвер). В Docker — том, общий с воркером склейки.
STORAGE_DIR=./data

# true — cookie только по HTTPS. Локально по http — false.
COOKIE_SECURE=false

# true — временный общий доступ для стенда команды: любой вошедший видит и правит все площадки.
# Не включать в продакшене.
OPEN_ACCESS=false

# Демо-организатор: создаётся командой `npm run seed -w services/api`, пароль берётся отсюда.
# Пустой — демо-учётка не создаётся. Не коммитить настоящий пароль.
DEMO_EMAIL=demo@space-map.local
DEMO_PASSWORD=
