{
  "name": "space-map-desktop",
  "productName": "Карта пространства",
  "version": "0.1.0",
  "description": "Карта пространства — приложение для компьютера: кабинет, редактор и карты в отдельном окне",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "ru.spacemap.desktop",
    "productName": "Карта пространства",
    "artifactName": "space-map-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Камера нужна, чтобы сканировать QR-код проекта."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signExecutable": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "compression": "maximum"
  }
}
